// VAULT schema — Phase 1 (catalogue) + Phase 2 (cart, inventory
// reservation, checkout, orders, discounts) + Phase 3 (search).
// Money is stored in integer minor units (cents). Currency is explicit
// on every amount. There is no Float price column anywhere in this file
// on purpose — see docs/decisions/0002-money-as-integer-minor-units.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// Staff / auth (Auth.js v5 adapter tables land in phase 2; this is the
// minimal role-bearing User needed so Media/Audit can reference an actor).
// ---------------------------------------------------------------------------

enum StaffRole {
  admin
  fulfilment
  support
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  staffRole    StaffRole?
  createdAt    DateTime   @default(now())

  uploadedMedia       Media[]
  carts               Cart[]
  orders              Order[]
  addresses           Address[]
  discountRedemptions DiscountRedemption[]
  wishlistItems       WishlistItem[]

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String   @default("Home") // e.g. "Home", "Work", "Office", "Other"
  fullName  String
  address   String   // Address line 1
  apartment String?  // Apartment, suite, unit (optional)
  city      String
  state     String
  zip       String
  country   String   @default("United States")
  phone     String?
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}



// ---------------------------------------------------------------------------
// Catalogue hierarchy
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")

  products Product[]

  createdAt DateTime @updatedAt
  updatedAt DateTime @default(now())

  @@index([parentId])
  @@map("categories")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isAutomatic Boolean  @default(false)
  // For automatic collections: a small serialized rule set (e.g. category + tag).
  // Kept as JSON rather than a bespoke rules engine — Phase 1 scope only needs
  // manual curation; automatic rules are evaluated at read time in lib/collections.ts.
  rules       Json?

  products CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ProductStatus @default(draft)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // The set of option dimensions this product varies by, e.g. ["Size", "Colour"].
  // Order matters: it drives the order variant selectors render in.
  optionNames String[]

  variants    ProductVariant[]
  media       Media[]
  collections CollectionProduct[]
  wishlistItems WishlistItem[]

  // Maintained by the app layer on create/update (see
  // lib/products.server.ts syncSearchVector) rather than a Postgres
  // GENERATED column or trigger — see docs/decisions/0011-search-engine-choice.md
  // for why. Excluded from normal Prisma Client selects; only ever
  // touched via raw SQL in search.server.ts.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tag-based ISR revalidation keys off slug + category slug; see lib/revalidate.ts.
  @@index([categoryId])
  @@index([status])
  @@index([searchVector], type: Gin)
  @@map("products")
}

// A single point in the option matrix, e.g. { Size: "M", Colour: "Indigo" }.
// Stored as JSON on the variant (not a normalized option-value table) because
// Phase 1 only needs to render and validate combinations, not run cross-product
// option analytics. See docs/decisions/0001-variant-options-as-json.md.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku     String @unique
  options Json // Record<string, string>, keys match Product.optionNames

  // Money: integer minor units + explicit ISO 4217 currency. Never a Float.
  priceAmount   Int
  priceCurrency String @default("USD")

  compareAtAmount Int?

  isEnabled Boolean @default(true) // impossible/disabled combinations live here, not as 404s
  position  Int     @default(0)

  weightGrams Int?

  inventoryItem InventoryItem?
  priceListEntries PriceListEntry[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Inventory (levels only in Phase 1 — reservation + concurrency control is
// Phase 2's job once checkout exists; the column shapes below anticipate it).
// ---------------------------------------------------------------------------

model InventoryItem {
  id        String @id @default(cuid())
  variantId String @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  onHand   Int @default(0)
  reserved Int @default(0) // populated starting Phase 2; kept here so the model doesn't migrate later
  // Optimistic concurrency column for the Phase 2 reservation system.
  version  Int @default(0)

  lowStockThreshold Int @default(5)

  reservations Reservation[]

  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video
}

model Media {
  id       String    @id @default(cuid())
  kind     MediaKind @default(image)
  url      String
  alt      String    @default("")
  width    Int?
  height   Int?
  position Int       @default(0)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Price lists (per-region / promotional pricing groundwork for later phases)
// ---------------------------------------------------------------------------

model PriceList {
  id       String  @id @default(cuid())
  name     String
  currency String
  isActive Boolean @default(true)

  entries PriceListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_lists")
}

model PriceListEntry {
  id          String @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  amount Int // integer minor units, currency inherited from PriceList

  @@unique([priceListId, variantId])
  @@map("price_list_entries")
}

// =============================================================================
// PHASE 2 — cart, inventory reservation, checkout, orders, discounts
// =============================================================================

// ---------------------------------------------------------------------------
// Cart. A guest cart is identified by an opaque session token in a cookie;
// a signed-in cart is identified by userId. Logging in merges the guest
// cart into the user's cart (see lib/cart.server.ts mergeGuestCartIntoUser).
// CartItem stores ONLY variantId + quantity — never a price. Every read
// recomputes price from ProductVariant.priceAmount at read time, which is
// what makes a tampered client-supplied price a no-op. See
// docs/decisions/0006-server-authoritative-cart.md.
// ---------------------------------------------------------------------------

model Cart {
  id           String   @id @default(cuid())
  sessionToken String?  @unique // set for guest carts, null once merged into a user
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  items        CartItem[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Reservation. Created only when a shopper enters checkout (never on
// add-to-cart). Holds a claim on InventoryItem.reserved with a TTL;
// SELECT ... FOR UPDATE on the InventoryItem row is what makes the
// "twenty parallel checkouts, one unit of stock, exactly one winner"
// guarantee hold. See docs/decisions/0007-inventory-reservation-locking.md.
// ---------------------------------------------------------------------------

model Reservation {
  id              String   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  cartId          String?
  cart            Cart?    @relation(fields: [cartId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quantity  Int
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([expiresAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Orders. State machine enforced in lib/orders.ts — illegal transitions are
// rejected in the domain layer, not hidden behind a disabled button. Money
// on every line is captured at the moment checkout started, so a later
// price edit in admin never changes a placed order's total.
// ---------------------------------------------------------------------------

enum OrderStatus {
  pending
  paid
  fulfilled
  delivered
  cancelled
  refunded
  failed
}

model Order {
  id     String      @id @default(cuid())
  number String      @unique // human-readable, e.g. VAULT-100042
  status OrderStatus @default(pending)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  email  String // captured even for guest checkout

  currency String

  subtotalAmount Int
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  shippingAddress Json? // Immutable shipping address snapshot { fullName, address, apartment, city, state, zip, country, phone }

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  stripePaymentIntentId String?  @unique
  reservationExpiresAt  DateTime // checkout-entry TTL; once paid, reservations convert to real stock decrement

  failureDetectedAt DateTime?
  refundInitiatedAt DateTime?
  failureReason    String?

  items        OrderItem[]
  reservations Reservation[]
  refunds      Refund[]
  fulfillments Fulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshot of the variant at order time — title/SKU/options/price never
  // drift even if the product is later edited or deleted.
  titleSnapshot   String
  skuSnapshot     String
  optionsSnapshot Json

  unitAmount Int
  quantity   Int
  lineTotal  Int // unitAmount * quantity, minus this line's share of the discount

  // Phase 4: how much of this line has shipped and how much has been
  // refunded, tracked independently so a line can be partially
  // fulfilled AND later partially refunded without either number lying
  // about the other. Both are invariant-checked in fulfillment.server.ts
  // and refunds.server.ts respectively — neither can exceed `quantity`.
  fulfilledQuantity Int @default(0)
  refundedQuantity  Int @default(0)

  fulfillmentItems FulfillmentItem[]
  refundItems      RefundLineItem[]

  @@map("order_items")
}

model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount              Int
  reason              String?
  stripeRefundId      String? @unique
  restocked           Boolean @default(false)

  items RefundLineItem[]

  createdAt DateTime @default(now())

  @@map("refunds")
}

// An itemized line within a refund — what was refunded, how much of it,
// so the restock decision (Phase 4) can act on specific variants
// instead of guessing from a bare dollar amount. A goodwill refund with
// no items is still valid (amount-only, restocked always false — see
// docs/decisions/0017-refunds-and-restock.md) so this list can be empty.
model RefundLineItem {
  id          String    @id @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int

  @@map("refund_line_items")
}

// ---------------------------------------------------------------------------
// Discounts. Percentage/fixed/free-shipping, with usage limits. The
// remainder-cent problem when a percentage discount is spread across
// multiple lines is handled by splitEvenly() in lib/money.ts — see
// docs/decisions/0002 and 0008.
// ---------------------------------------------------------------------------

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

model Discount {
  id   String @id @default(cuid())
  code String @unique

  type  DiscountType
  value Int // percentage: 0-100. fixed_amount: integer minor units. free_shipping: ignored.

  currency String? // required when type = fixed_amount

  usageLimit       Int? // total redemptions allowed, null = unlimited
  perCustomerLimit Int? @default(1)
  minimumSpend     Int? // integer minor units, same currency as the order

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  redemptions DiscountRedemption[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discounts")
}

model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId    String   @unique
  createdAt  DateTime @default(now())

  @@map("discount_redemptions")
}

// ---------------------------------------------------------------------------
// Stripe webhook idempotency. The event id is the natural idempotency key —
// Stripe guarantees it's unique and stable across redeliveries. Inserting it
// first, inside the same transaction that processes the event, is what makes
// "replay this event five times -> one order, one stock decrement" hold even
// under concurrent duplicate delivery. See docs/decisions/0009.
// ---------------------------------------------------------------------------

model StripeEvent {
  id          String   @id // Stripe's event.id, used as-is — no surrogate key
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

// =============================================================================
// PHASE 4 — operations and hardening: fulfillment, inventory adjustments,
// audit log
// =============================================================================

// ---------------------------------------------------------------------------
// Fulfillment. One order can have multiple fulfillments (partial
// shipments), each covering some quantity of some order items. An
// order's derived "fully fulfilled" state is computed by comparing
// each OrderItem.fulfilledQuantity against its quantity — see
// lib/fulfillment.server.ts — rather than stored as a separate flag
// that could drift from the line-item detail backing it.
// ---------------------------------------------------------------------------

model Fulfillment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  trackingNumber String
  carrier        String?

  items FulfillmentItem[]

  createdAt DateTime @default(now())

  @@map("fulfillments")
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity      Int

  @@map("fulfillment_items")
}

// ---------------------------------------------------------------------------
// Inventory adjustments. Every manual stock change goes through
// adjustStock() in lib/inventory-admin.server.ts, which uses the same
// SELECT ... FOR UPDATE locking as the Phase 2 reservation path (see
// ADR 0007) and writes exactly one of these rows per adjustment — the
// running history the brief's "adjustment history with reason codes"
// asks for.
// ---------------------------------------------------------------------------

enum InventoryAdjustmentReason {
  received
  damaged
  lost
  returned
  correction
  other
}

model InventoryAdjustment {
  id              String  @id @default(cuid())
  inventoryItemId String
  variantId       String // denormalized alongside inventoryItemId so history survives a variant's inventory row being recreated

  delta          Int // positive or negative
  resultingOnHand Int // onHand immediately after this adjustment — makes the history self-contained, no need to replay deltas to know stock at any point in time

  reason InventoryAdjustmentReason
  note   String?

  actorUserId  String // no FK — see docs/decisions/0018-audit-log-append-only.md; the record must outlive the actor
  actorEmail   String

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([variantId])
  @@map("inventory_adjustments")
}

// ---------------------------------------------------------------------------
// Audit log. Append-only in two senses: the application layer exposes
// only appendAuditLog() (lib/audit.server.ts) and never an update or
// delete function; the database itself additionally enforces this with
// a trigger (see prisma/manual/audit-log-append-only.sql) so the
// guarantee doesn't depend on every future caller reading the
// application-layer rule. See docs/decisions/0018.
// ---------------------------------------------------------------------------

enum AuditAction {
  create
  update
  delete
  transition
  refund
  adjustment
}

model AuditLogEntry {
  id String @id @default(cuid())

  actorUserId String // no FK — see above
  actorEmail  String
  actorRole   StaffRole?

  entityType String // "Product", "Order", "InventoryItem", ...
  entityId   String
  action     AuditAction

  before Json? // null for a create
  after  Json? // null for a delete

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// System settings. Stores persistent store and platform settings in a
// strongly-typed key-value structure managed by verified Admin staff.
// ---------------------------------------------------------------------------
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Customer Wishlist. Enables authenticated customers to save products.
// ---------------------------------------------------------------------------
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Transactional Notification Records. Provides persistent, concurrency-safe
// deduplication, atomic lease claims, and crash recovery for transactional emails.
// ---------------------------------------------------------------------------

enum NotificationStatus {
  pending
  dispatching
  sent
  failed
}

model NotificationRecord {
  id            String             @id // e.g. "vault_email_${orderId}_${kind}"
  orderId       String
  kind          String             // "paid" | "fulfillment" | "refund"
  recipient     String
  status        NotificationStatus @default(pending)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  payload       Json?              // Immutable event snapshot
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("notification_records")
}


