# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vault?schema=public"

# Auth.js v5
AUTH_SECRET="generate-with-npx-auth-secret"

# UploadThing (product media)
UPLOADTHING_TOKEN=""

# Generic tag-revalidation endpoint (see /api/revalidate)
REVALIDATE_SECRET="a-long-random-string"

# Stripe (wired up starting Phase 2 — present here so .env shape doesn't change later)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Auth.js v5 needs to know its own origin outside of Vercel
NEXTAUTH_URL="http://localhost:3000"
